# FLAEVRD Network configuration. Copy to `.env` and fill in. Never commit `.env`.
# Every key is optional: a provider without credentials is shown as "waiting for configuration"
# and simply skipped. Nothing is ever replaced with mock data.

# --- Required for polite API use -------------------------------------------------
# MusicBrainz and Wikidata require a User-Agent with a contact address.
FLAEVRD_CONTACT_EMAIL=you@example.com

# --- Credits & metadata ----------------------------------------------------------
# Genius: https://genius.com/api-clients -> "New API Client" -> "Generate Access Token"
GENIUS_ACCESS_TOKEN=
# Discogs: https://www.discogs.com/settings/developers -> "Generate new token"
DISCOGS_TOKEN=
# MusicBrainz and Wikidata/Wikipedia need no key.

# --- Audience metrics --------------------------------------------------------------
# YouTube Data API v3: https://console.cloud.google.com -> enable "YouTube Data API v3" -> Credentials -> API key
YOUTUBE_API_KEY=
# Last.fm: https://www.last.fm/api/account/create
LASTFM_API_KEY=
# Spotify (identity + genres only; see docs/PROVIDERS.md): https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Contact discovery -------------------------------------------------------------
# Fetch official websites (as linked from MusicBrainz/Wikidata) to find published business contacts.
# robots.txt is always respected.
FLAEVRD_WEB_CONTACTS=true

# --- Storage & research limits -------------------------------------------------------
FLAEVRD_DB_PATH=data/flaevrd.db
# How many releases / credited recordings to analyse per person (higher = slower, more complete)
FLAEVRD_MAX_RELEASES=8
FLAEVRD_MAX_CREDIT_RECORDINGS=25
# How many direct collaborators to expand for second-degree discovery
FLAEVRD_MAX_EXPANSIONS=6
# HTTP cache lifetime in hours
FLAEVRD_CACHE_HOURS=168
